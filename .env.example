# OCP Bionic Judge Agent — Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API (gratuit — https://aistudio.google.com/app/apikey)
# Les clés Google AI Studio commencent par "AIza..."
GEMINI_API_KEY=AIza...

# API Security
API_SECRET_KEY=your-secret-key-here

# JWT signing secret — if not set, a random one is generated per process start
# which invalidates all active browser sessions on every API restart.
# Set an explicit value in production to survive restarts.
JWT_SECRET=change-me-in-production-long-random-string

# Cookie security — set to true when deployed behind HTTPS (production only)
# Leave false for local HTTP dev (localhost:8000 / localhost:5173)
COOKIE_SECURE=false

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production) — recommended
DATABASE_URL=postgresql://ocp_user:ocp_password@localhost:5432/ocp_bionic

# SQLite (local dev/test only) — uncomment to use instead of PostgreSQL
# DATABASE_URL=sqlite:///data/ocp_bionic.db

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=5173
