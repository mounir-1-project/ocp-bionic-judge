# =============================================================================
# Configuration — copier en .env et adapter
#
# Le systeme fonctionne INTEGRALEMENT sans ce fichier : toutes les valeurs
# ci-dessous ont un defaut raisonnable.
# =============================================================================

# Journalisation
LOG_LEVEL=INFO

# Source de donnees
# DCS_EXPORT=data/raw/DATA.xlsx

# Modele
# REFERENCE_END=2024-07-13
CONTAMINATION=0.02
RANDOM_SEED=42
MODEL_STRATEGY=auto

# Rejeu
REPLAY_SPEED=120
REPLAY_STEP=3

# API
API_HOST=127.0.0.1
API_PORT=8000
