# =============================================================================
# Configuration — copier en .env et adapter
#
# Le systeme fonctionne INTEGRALEMENT sans ce fichier : toutes les valeurs
# ci-dessous ont un defaut raisonnable. Il sert a adapter le service a un
# environnement particulier, pas a le rendre fonctionnel.
# =============================================================================

# ── Journalisation ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Passer a true pour une collecte centralisee (ELK, Loki) : chaque ligne de
# journal devient un objet JSON.
LOG_JSON=false
# LOG_FILE=logs/e7301.log

# ── Source de donnees ────────────────────────────────────────────────────────
# Pointe vers l'export DCS a surveiller. Seul point d'entree des donnees.
# DCS_EXPORT=data/raw/DATA.xlsx

# ── Modele ───────────────────────────────────────────────────────────────────
# Fin de la periode de reference servant a apprendre le comportement normal.
# A ANCRER SUR LA DATE DE LA DERNIERE REVISION de l'equipement des qu'OCP la
# communique : sans cela, le jumeau apprend sur une periode dont on ignore si
# l'echangeur y etait propre.
# REFERENCE_END=2024-07-13

CONTAMINATION=0.02
RANDOM_SEED=42
# auto : charge l'artefact seulement si empreinte des données, schéma et
# calibration concordent ; artifact : échoue explicitement sinon ; train :
# reconstruit toujours le candidat au démarrage.
MODEL_STRATEGY=auto
# Seuls des artefacts explicitement promus peuvent être chargés.
MODEL_ALLOWED_STATUSES=shadow_only,approved_for_pilot,approved_for_production
# Registre local durable du cycle de vie des alarmes.
# ALARM_DB=data/runtime/alarms.db

# ── Rejeu de demonstration ───────────────────────────────────────────────────
# Heures de process simulees par seconde reelle.
REPLAY_SPEED=120
REPLAY_STEP=3

# ── API ──────────────────────────────────────────────────────────────────────
# Ces deux valeurs sont honorees par `python -m api` et par l'image Docker.
# Boucle locale par defaut : un poste de demonstration ne doit pas etre
# joignable depuis le reseau sans decision explicite. Le conteneur surcharge
# API_HOST a 0.0.0.0, ou l'exposition reste controlee par le mapping de port.
API_HOST=127.0.0.1
API_PORT=8000
# N'ouvrir CORS que si un front est deploye sur une autre origine.
# CORS_ORIGINS=https://supervision.ocp.local

# ── Accès technicien ─────────────────────────────────────────────────────────
# Aucun secret, aucune empreinte, aucune adresse réelle n'est livrée ici.
#
# LA MÉTHODE RECOMMANDÉE N'EXIGE AUCUNE VARIABLE CI-DESSOUS :
#     python scripts/manage_operators.py add
# Chaque technicien obtient son propre mot de passe, et l'accès protégé
# s'active de lui-même au démarrage suivant. C'est le seul mode acceptable
# dès lors que l'adresse de session détermine le destinataire des alertes.
APP_ENV=demo
AUTH_PROVIDER=local_demo

# Registre local des techniciens. Hors dépôt, ignoré par git.
# OPERATOR_REGISTRY=data/runtime/operators.json

# Forçage explicite. Laisser vide : la valeur est déduite du registre.
# AUTH_ENABLED=true
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_HOURS=8
# true uniquement lorsque le service est exposé en HTTPS.
AUTH_SECURE_COOKIE=false

# ── Mode historique, DÉCONSEILLÉ ─────────────────────────────────────────────
# Un mot de passe unique partagé par toute l'équipe : il circule, ne se révoque
# pas individuellement, et le journal d'authentification ne peut plus dire qui
# s'est connecté. Conservé pour les déploiements existants.
# python -c "from src.security import hash_password; print(hash_password('une phrase secrete longue'))"
# AUTH_PASSWORD_HASH=pbkdf2_sha256$...
# AUTH_ALLOWED_EMAILS=lecteur@exemple.test,maintenance@exemple.test
# AUTH_USER_ROLES_JSON={"lecteur@exemple.test":"reader","maintenance@exemple.test":"maintenance"}

# ── Notifications email — OPTIONNELLES ──────────────────────────────────────
# L'email complète l'alarme HMI ; il ne la remplace jamais. Les envois sont
# asynchrones, dédupliqués par mode/sévérité et limités par un délai.
# Sans SMTP_HOST et SMTP_FROM, aucun courriel ne part : le canal reste inactif
# et la vue Controle affiche explicitement pourquoi. L'adresse du technicien
# connecte devient destinataire; ces variables ne font que fournir le relais.
# SMTP_HOST=smtp.ocp.local
SMTP_PORT=587
# SMTP_USERNAME=compte_service_e7301
# SMTP_PASSWORD=secret_via_coffre
# SMTP_FROM=e7301-monitor@ocpgroup.ma
# Destinataire de repli facultatif hors session. En exploitation, l'adresse
# saisie par le technicien à la connexion devient le destinataire actif.
# ALERT_EMAIL_TO=astreinte@ocpgroup.ma
SMTP_STARTTLS=true
ALERT_MIN_SEVERITY=CRITICAL
ALERT_COOLDOWN_MINUTES=60

# ── Modele de langage — OPTIONNEL ────────────────────────────────────────────
# Sans cle, agent et Judge fonctionnent en mode deterministe. La cle n'active
# QUE la couche de redaction : la verification du Judge reste deterministe
# dans tous les cas. Le rejeu temps reel n'appelle jamais le LLM afin de garder
# une latence bornee. Sur une analyse a la demande, le premier echec du service
# ouvre un coupe-circuit et le resultat par regles reste disponible.
# GEMINI_API_KEY=votre_cle_google_ai_studio
# GEMINI_MODEL=gemini-2.0-flash
